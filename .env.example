# ═══════════════════════════════════════════════════════════════════════════
# FilipinoDama Royal — environment template
# ───────────────────────────────────────────────────────────────────────────
# Copy to `.env` for local dev (this file is committed; `.env` is gitignored).
# For PRODUCTION, set these in the Railway *service* Variables, NOT in a file.
#
# ⚠️  PRODUCTION SAFETY GATE (apps/server/src/config/env.ts):
#     When NODE_ENV=production the server REFUSES TO BOOT unless:
#       • JWT_ACCESS_SECRET and JWT_REFRESH_SECRET are strong (>=32 chars),
#         different from each other, and NOT the dev defaults below, and
#       • CORS_ORIGIN and WEB_ORIGIN are real origins (not localhost).
#     This is deliberate — it prevents shipping with forgeable tokens or open CORS.
#     Generate each secret with:  openssl rand -base64 48
# ═══════════════════════════════════════════════════════════════════════════

# ── server: core ───────────────────────────────────────────
NODE_ENV=development                 # production sets this to "production"
PORT=4000                            # Railway injects its own PORT in prod
DATABASE_URL=postgresql://dama:dama@localhost:5432/dama   # prod: Railway Postgres URL
REDIS_URL=redis://localhost:6379                          # prod: Railway Redis URL

# ── server: auth / JWT ─────────────────────────────────────
# DEV values below are fine locally. In PROD use two DIFFERENT strong secrets
# (openssl rand -base64 48) — the server will not start with these dev strings.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── server: origins (CORS + links) ─────────────────────────
# The single production web origin the browser runs on. Locking CORS to it is a
# security requirement; both must be the real https origin in prod.
CORS_ORIGIN=http://localhost:5173    # prod: https://filipinodama.com
WEB_ORIGIN=http://localhost:5173     # prod: https://filipinodama.com
#   WEB_ORIGIN is used for PayMongo success/cancel redirects and reset-email links.
# Shared parent domain for the auth cookies so filipinodama.com (web) and
# api.filipinodama.com (API) can both read them. REQUIRED in prod if API is on a
# subdomain. Leave EMPTY for local dev (same-origin).
COOKIE_DOMAIN=                       # prod: .filipinodama.com  (note the leading dot)

# ── oauth (optional; empty ⇒ that provider's button is disabled) ──
# Set the provider's Authorized redirect URI to:
#   <OAUTH_CALLBACK_BASE>/api/auth/oauth/google/callback   (and /facebook/…)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
OAUTH_CALLBACK_BASE=http://localhost:4000   # prod: https://api.filipinodama.com

# ── payments (PayMongo — GCash/Maya/cards) ─────────────────
# Diamonds are credited ONLY by the signature-verified webhook (event
# checkout_session.payment.paid). There is no browser-side crediting.
# In PayMongo, add a webhook pointing at:
#   <OAUTH_CALLBACK_BASE or api origin>/api/payments/webhook
# and paste its signing secret into PAYMONGO_WEBHOOK_SECRET.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PUBLIC_KEY=

# ── email (Resend — email verification / password reset) ───
# EMAIL_FROM's domain must be SPF+DKIM verified in Resend or sending fails.
RESEND_API_KEY=
EMAIL_FROM="FilipinoDama Royal <no-reply@filipinodama.gg>"

# ── storage (optional; Cloudflare R2 / S3-compatible avatar upload) ──
S3_ENDPOINT=
S3_BUCKET=dama-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── web (VITE_ prefixed = compiled into the browser bundle at BUILD time) ──
# These must be set when the WEB service is BUILT (not just at runtime), because
# Vite inlines them. In prod point them at the API service's public origin.
VITE_API_URL=http://localhost:4000      # prod: https://api.filipinodama.com
VITE_SOCKET_URL=http://localhost:4000   # prod: https://api.filipinodama.com
