<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-variant manifest override. Merged only into debug builds (manifest
  merger keys off the src/debug source set) — attaches the cleartext
  allowlist in network_security_config.xml so requests to the local dev
  server (http://10.0.2.2:4000) are not blocked by Android's default
  cleartext-traffic policy. Release keeps the platform default (no cleartext).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
