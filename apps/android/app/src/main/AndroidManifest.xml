<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ (API 33+) runtime permission gate for posting local/remote
         notifications. Requested from the Settings screen's notification-prefs
         toggle (push readiness — see PushNotifications.kt); harmless to
         declare even though no notification is posted yet in this phase. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      taskAffinity="" opts every activity out of the shared, package-named task.

      With the DEFAULT affinity ("com.filipinodama.app"), a malicious app on an
      unpatched API 26-30 device — in range, since minSdk is 26 — can declare the
      SAME taskAffinity with allowTaskReparenting and insert a phishing screen
      into our task stack: the user backs out of a match and lands on an
      attacker-drawn login prompt that looks like ours. Android 11/12 task-reuse
      restrictions mitigate this on newer/patched devices; this closes the tail.
      No behavioural change for a single-activity app.
    -->
    <application
        android:taskAffinity=""
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FilipinoDama">
        <!--
          windowSoftInputMode="adjustResize" below is REQUIRED, not cosmetic.
          Without it the system chose PAN for this window: opening the keyboard
          slid the WHOLE window up by the keyboard's height (measured on a
          1080x1600 display — the wordmark jumped from y=415 to y=49) instead of
          reflowing. Panning means the layout never learns the keyboard exists:
          WindowInsets.ime stays empty, so imePadding() / screenInsetsWithIme()
          are inert and verticalScroll has nothing extra to scroll. The Sign in
          button was simply pushed off the bottom, unreachable by any amount of
          scrolling (owner report, v53: "I can't press the button to sign" —
          reproduced, six scroll attempts never brought it back).

          With adjustResize the window shrinks to the space above the keyboard,
          WindowInsets.ime reports its real height, and the form screens'
          union(systemBars, ime) padding + verticalScroll keep the CTA on screen.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FilipinoDama">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Android App Links — private-room invites ONLY.

              PrivateRoomScreen shares rooms as "${WEB_ORIGIN}/rooms?code=XXXX"
              (PrivateRoomScreen.kt roomUrl), so before this filter existed a
              room invite sent from the app always bounced the recipient into a
              BROWSER — the one cross-platform flow the app itself generates
              links for. DeepLinks.kt parses the code back out and routes to
              AppDestinations.privateRoom().

              DELIBERATELY NARROW on two axes; widen only with care:

              1. pathPrefix="/rooms", NOT the whole site. Verification is
                 per-host, but Android only auto-opens paths this filter
                 matches, so /blog, /learn, /legal, the SEO landing pages and
                 especially /damath (web-only by owner directive) keep opening
                 in the browser — which is what they should do. Adding a path
                 here means committing to a real in-app screen for it.

              2. host="filipinodama.com" ONLY, no www. www.filipinodama.com
                 301-redirects to the apex and so does not serve its own
                 /.well-known/assetlinks.json, and Android does NOT follow
                 redirects when verifying. Listing it would leave an
                 unverifiable host inside an autoVerify filter, which on
                 Android 12+ fails verification for EVERY host in the app —
                 silently killing App Links altogether.

              Query strings are not matchable here (pathPrefix covers the path
              only); ?code= and &spectate= are read off the Uri at runtime.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="filipinodama.com"
                    android:pathPrefix="/rooms" />
            </intent-filter>
        </activity>
    </application>

</manifest>
