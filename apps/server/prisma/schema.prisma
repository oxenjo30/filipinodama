generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────── Identity ───────────────
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?
  isGuest       Boolean   @default(false)
  // Matchmaking NPC/bot account (fills empty queues). Excluded from the public
  // leaderboard + season-end reward ranking so bots never pollute real standings.
  isBot         Boolean   @default(false)
  username      String    @unique
  displayName   String
  tag           String    @unique
  bio           String?   @db.Text
  avatarUrl     String?
  frameId       String?
  countryCode   String?

  // admin / moderation (ADMIN_DASHBOARD.md §1) — null for normal players
  adminRole AdminRole?
  // null = active admin; non-null = disabled admin (role retained but admin
  // access blocked by requireAdmin — see auth/guards.ts)
  adminDisabledAt DateTime?
  // moderation state
  bannedUntil     DateTime?
  matchAnalyses          MatchAnalysis[] @relation("matchAnalyses")
  matchAnalysesReviewed  MatchAnalysis[] @relation("matchAnalysesReviewed")
  mutedUntil      DateTime?
  verifyToken     String?   @unique // email-verification token (nullable)
  verifyExpires   DateTime?
  resetToken      String?   @unique // password-reset token (nullable)
  resetExpires    DateTime?

  // economy caches (authoritative source = LedgerEntry aggregates)
  trophies Int    @default(0) // new players start at Squire (0); earn trophies to climb
  gold     Int    @default(0)
  diamonds Int    @default(0)
  rankTier String @default("squire") // packages/shared ranks.ts (Squire..Alamat)

  // equipped cosmetics
  equippedBoard String?
  equippedSkin  String?
  equippedEmotes String[] // owned emote itemIds the player has equipped (max 6)

  // stats
  wins   Int @default(0)
  losses Int @default(0)
  draws  Int @default(0)
  streak Int @default(0)

  // daily login bonus — server-authoritative streak (client localStorage would
  // be trivially farmable). loginStreak is the current consecutive-day count
  // (1..7, cycles); lastLoginBonusAt is when the last bonus was claimed.
  loginStreak      Int       @default(0)
  lastLoginBonusAt DateTime?

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  deletedAt  DateTime?

  oauthAccounts  OAuthAccount[]
  sessions       Session[]
  ledger         LedgerEntry[]
  inventory      InventoryItem[]
  orders         Order[]
  payments       Payment[]
  matchesRed     Match[]          @relation("red")
  matchesBlue    Match[]          @relation("blue")
  damathRed      DamathMatch[]    @relation("damathRed")
  damathBlue     DamathMatch[]    @relation("damathBlue")
  sentReqs       FriendRequest[]  @relation("from")
  recvReqs       FriendRequest[]  @relation("to")
  friendshipsA   Friendship[]     @relation("a")
  friendshipsB   Friendship[]     @relation("b")
  blocksMade     Block[]          @relation("blocker")
  blocksReceived Block[]          @relation("blocked")
  guildMember    GuildMember?
  messagesSent   Message[]
  notifications  Notification[]
  questProgress  QuestProgress[]
  seasonProgress SeasonProgress[]
  reportsMade     Report[] @relation("reportsMade")
  reportsAgainst  Report[] @relation("reportsAgainst")
  reportsResolved Report[] @relation("reportsResolved")
  campaignsSent Campaign[]
  ticketsFiled    Ticket[]        @relation("ticketsFiled")
  ticketsResolved Ticket[]        @relation("ticketsResolved")
  ticketMessages  TicketMessage[] @relation("ticketMessages")
  tournamentsCreated Tournament[]      @relation("tournamentsCreated")
  tournamentEntries  TournamentEntry[] @relation("tournamentEntries")
  liveEventsCreated  LiveEvent[]       @relation("liveEventsCreated")
  dailyActivity      DailyActivity[]

  @@index([trophies])
}

// One row per user per active (UTC) day — the durable per-day activity log that
// true retention (D1/D7/D30, cohorts) needs. `lastSeenAt` on User is a single
// mutable timestamp and can't reconstruct which days a user was active, so this
// table records each active day exactly once (upserted from the presence hook
// that also touches lastSeenAt). `day` is a date at UTC midnight.
//
// NOTE: this only accrues from the day it deploys — there is no back-history,
// so retention charts are sparse at first and become meaningful over ~weeks.
model DailyActivity {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime // UTC-midnight date of the active day
  createdAt DateTime @default(now())

  @@unique([userId, day])
  @@index([day])
}

model OAuthAccount {
  id         String @id @default(cuid())
  provider   String
  providerId String
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// ─────────────── Economy ───────────────
enum Currency {
  GOLD
  DIAMONDS
  TROPHIES
}

model LedgerEntry {
  id        String   @id @default(cuid())
  userId    String
  // ACCOUNT PURGE: cascade. This is in-game currency history (gold/diamonds) —
  // the player's own economy record, not a financial document. Real-money rows
  // live in Payment, which is retained instead; see its relation.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency  Currency
  amount    Int
  balance   Int
  reason    String
  refType   String?
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, currency, createdAt])
  // Idempotency: a given (user, reason, ref) credit can only be applied once.
  // Postgres treats NULL refType/refId as distinct, so unref'd adjustments are
  // unaffected — this only guards ref'd grants (match/quest/payment) from double
  // application. applyLedger treats a unique-violation as an already-done no-op.
  @@unique([userId, currency, reason, refType, refId])
}

// ─────────────── Store & inventory ───────────────
enum ItemType {
  BOARD
  SKIN
  AVATAR
  FRAME
  EMOTE
  BUNDLE
  SEASON_PASS
}

model StoreItem {
  id            String          @id
  type          ItemType
  name          String
  description   String?         @db.Text
  priceGold     Int?
  priceDiamonds Int?
  assetKey      String
  previewKey    String?
  tag           String? // NEW | PREMIUM | VALUE | -35% | SEASON (store badge)
  bundleItems   String[]
  isPremium     Boolean         @default(false)
  active        Boolean         @default(true)
  // Daily Deals: when set, this is the discounted price and priceGold/priceDiamonds
  // is the struck-through original. onSale gates the Daily Deals section.
  salePrice     Int?
  onSale        Boolean         @default(false)
  // Featured: curated items shown on the store's Featured/All tab.
  featured      Boolean         @default(false)
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())
  inventory     InventoryItem[]
}

model InventoryItem {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  item       StoreItem @relation(fields: [itemId], references: [id])
  equipped   Boolean   @default(false)
  acquiredAt DateTime  @default(now())

  @@unique([userId, itemId])
}

model Order {
  id        String   @id @default(cuid())
  userId    String
  // ACCOUNT PURGE: cascade. An Order is an in-game store purchase (gold-only
  // today), not a real-money receipt — the money side is Payment.
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Json
  currency  Currency
  total     Int
  status    String   @default("completed")
  createdAt DateTime @default(now())
}

model Payment {
  id           String    @id @default(cuid())
  // ACCOUNT PURGE: RETAINED, link severed (owner decision 2026-08-02).
  // This is the only real-money record in the schema. Financial records carry
  // statutory retention obligations that outlive an erasure request, so the
  // purge nulls userId rather than deleting the row: the transaction survives
  // for accounting/tax, with no link back to a person. Every other trace of the
  // account is destroyed. Nullable purely to make SetNull possible.
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider     String    @default("paymongo")
  providerRef  String    @unique // PayMongo event id (idempotency key for crediting)
  amountCents  Int // PHP centavos (₱100 = 10000)
  currencyCode String    @default("php")
  diamonds     Int
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  settledAt    DateTime?
}

// ─────────────── Matches & replays ───────────────
enum MatchMode {
  AI
  CASUAL
  RANKED
  PRIVATE
  LOCAL
  DAMATH
}

model Match {
  id              String    @id @default(cuid())
  mode            MatchMode
  redId           String?
  red             User?     @relation("red", fields: [redId], references: [id])
  blueId          String?
  blue            User?     @relation("blue", fields: [blueId], references: [id])
  settings        Json
  moves           Json
  winner          String?
  reason          String?
  redTrophyDelta  Int?
  blueTrophyDelta Int?
  goldReward      Int?      @default(0)
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  tournamentMatch TournamentMatch?
  analyses        MatchAnalysis[]

  @@index([redId])
  @@index([blueId])
  @@index([mode, endedAt])
}

/// Anti-cheat: one row per (match, player) holding the ENGINE AGREEMENT result
/// for that player in that match, plus its review state.
///
/// Stored rather than computed on read because the analysis replays the whole
/// game against the engine — far too expensive to redo every time a moderator
/// opens the queue.
///
/// `decisionCount` is the sample size that matters, NOT `moveCount`: Dama forces
/// captures, so plies with a single legal move carry no information and are
/// excluded from both the numerator and the denominator (see lib/anticheat.ts).
///
/// Nothing here bans anyone. A FLAGGED row is a case for a human to judge;
/// CONFIRMED/DISMISSED record what that human decided.
model MatchAnalysis {
  id               String         @id @default(cuid())
  matchId          String
  match            Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId           String
  user             User           @relation("matchAnalyses", fields: [userId], references: [id], onDelete: Cascade)
  side             String         // "red" | "blue"

  moveCount        Int
  decisionCount    Int
  engineMatchCount Int
  /// engineMatchCount / decisionCount. Null when the player had no free choice.
  engineMatchRate  Float?
  /// 0-100. Null when the sample was below the significance floor.
  suspicion        Int?
  /// Why this scored the way it did, shown verbatim to the moderator.
  reasons          String[]

  status           AnalysisStatus @default(CLEAR)
  reviewedById     String?
  reviewedBy       User?          @relation("matchAnalysesReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  reviewNote       String?        @db.Text

  computedAt       DateTime       @default(now())

  @@unique([matchId, userId])
  @@index([status, suspicion])
  @@index([userId, status])
}

enum AnalysisStatus {
  /// Analysed, nothing to answer for.
  CLEAR
  /// Above threshold — waiting on a moderator.
  FLAGGED
  /// A moderator judged this to be cheating.
  CONFIRMED
  /// A moderator judged this to be legitimate.
  DISMISSED
}

/// Math Dama (Damath) match record. Unranked, no economy at launch: scores +
/// history persist for replay/stats only. Fully separate from `Match` so the
/// Classic table is never touched. `redScore`/`blueScore` are FINAL totals
/// (captures + end-of-game chip bonus); `scoreHistory` holds the score events
/// and `moveHistory` is the replay source of truth.
model DamathMatch {
  id           String    @id @default(cuid())
  variant      String    // DamathVariant, e.g. "whole"
  redId        String?
  red          User?     @relation("damathRed", fields: [redId], references: [id])
  blueId       String?
  blue         User?     @relation("damathBlue", fields: [blueId], references: [id])
  redScore     Float     @default(0)
  blueScore    Float     @default(0)
  winner       String?   // "red" | "blue" | "draw"
  reason       String?   // DamathEndReason
  scoreHistory Json      @default("[]")
  moveHistory  Json      @default("[]")
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([redId])
  @@index([blueId])
  @@index([endedAt])
}

// ─────────────── Social ───────────────
model FriendRequest {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("to", fields: [toId], references: [id], onDelete: Cascade)
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@unique([fromId, toId])
}

model Friendship {
  id        String   @id @default(cuid())
  aId       String
  a         User     @relation("a", fields: [aId], references: [id], onDelete: Cascade)
  bId       String
  b         User     @relation("b", fields: [bId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([aId, bId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

enum ChannelType {
  DM
  ROOM
  GUILD
}

model Channel {
  id        String          @id @default(cuid())
  type      ChannelType
  refId     String?
  createdAt DateTime        @default(now())
  members   ChannelMember[]
  messages  Message[]
}

model ChannelMember {
  id         String   @id @default(cuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  lastReadAt DateTime @default(now())

  @@unique([channelId, userId])
}

model Message {
  id        String   @id @default(cuid())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  // ACCOUNT PURGE: cascade. Their messages are their content and go with the
  // account. This does NOT destroy moderation evidence: Report stores a
  // denormalised `excerpt` snapshot of the cited message, not a Message FK.
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([channelId, createdAt])
}

enum ReportReason {
  HARASSMENT
  HATE_SPEECH
  CHEATING
  INAPPROPRIATE
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id              String       @id @default(cuid())
  reporterId      String?
  reporter        User?        @relation("reportsMade", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterName    String
  accusedId       String?
  accused         User?        @relation("reportsAgainst", fields: [accusedId], references: [id], onDelete: SetNull)
  accusedName     String
  reason          ReportReason
  note            String?      @db.Text
  context         String       // "dm" | "profile"
  channelId       String?
  messageId       String?
  excerpt         String?      @db.Text
  profileSnapshot Json?
  status          ReportStatus @default(OPEN)
  resolvedById    String?
  resolvedBy      User?        @relation("reportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolution      String?
  createdAt       DateTime     @default(now())
  resolvedAt      DateTime?

  @@index([status, createdAt])
  @@index([accusedId])
  @@index([reporterId, createdAt])
}

// ─────────────── Guilds ───────────────
model Guild {
  id           String             @id @default(cuid())
  name         String             @unique
  tag          String             @unique
  description  String?            @db.Text
  crestKey     String?
  minTrophies  Int                @default(0)
  joinPolicy   String             @default("open") // open | request | invite
  weeklyPoints Int                @default(0)
  createdAt    DateTime           @default(now())
  members      GuildMember[]
  joinRequests GuildJoinRequest[]
}

enum GuildRole {
  LEADER
  OFFICER
  MEMBER
}

model GuildMember {
  id                 String    @id @default(cuid())
  guildId            String
  guild              Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               GuildRole @default(MEMBER)
  weeklyContribution Int       @default(0)
  joinedAt           DateTime  @default(now())
}

model GuildJoinRequest {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@unique([guildId, userId])
}

// ─────────────── Guild Wars ───────────────
// Weekly contribution ladder: ranked wins by a member add war points to their
// guild (Guild.weeklyPoints) + the member (GuildMember.weeklyContribution). At
// weekly reset the top-N guilds earn a gold pot split among contributors, then
// points reset and a new season opens.

model GuildWarSeason {
  id        String    @id @default(cuid())
  // Monotonic week index (also the human-facing "Week N").
  weekIndex Int       @unique
  startsAt  DateTime  @default(now())
  endsAt    DateTime
  // "active" while running, "settled" once rewards are paid at reset.
  status    String    @default("active")
  settledAt DateTime?
  results   GuildWarResult[]
}

// A frozen snapshot of one guild's final standing in a settled war season —
// the "War Log" history rows shown in the Wars tab.
model GuildWarResult {
  id        String         @id @default(cuid())
  seasonId  String
  season    GuildWarSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  guildId   String
  guildName String // denormalized so history survives a guild rename/delete
  guildTag  String
  crestKey  String?
  rank      Int
  points    Int
  rewardGold Int           @default(0)
  createdAt DateTime       @default(now())

  @@index([seasonId, rank])
  @@index([guildId])
}

// ─────────────── Progression ───────────────
model Quest {
  id          String          @id
  scope       String
  title       String
  description String?
  goal        Int
  rewardGold  Int             @default(0)
  active      Boolean         @default(true)
  /// { event: QuestEvent } — validated by questTriggerSchema (lib/quest-trigger.ts).
  /// Null = doesn't track (pre-trigger custom quest); see docs spec 2026-07-11.
  trigger     Json?
  progress    QuestProgress[]
}

model QuestProgress {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId   String
  quest     Quest   @relation(fields: [questId], references: [id], onDelete: Cascade)
  value     Int     @default(0)
  claimed   Boolean @default(false)
  periodKey String

  @@unique([userId, questId, periodKey])
}

model Season {
  id        String           @id
  name      String
  number    Int?
  endsLabel String?
  startsAt  DateTime
  endsAt    DateTime
  tiers     Json
  progress  SeasonProgress[]
}

model SeasonProgress {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId String
  season   Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  xp       Int     @default(0)
  hasPass  Boolean @default(false)
  claimed  Int[]

  @@unique([userId, seasonId])
}

// ─────────────── Notifications ───────────────
model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String?
  data        Json?
  readAt      DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// ─────────────── Admin & moderation (ADMIN_DASHBOARD.md §1) ───────────────
enum AdminRole {
  SUPPORT
  MODERATOR
  ECONOMY
  SUPERADMIN
}

/// Append-only audit trail. Every admin mutation writes one row
/// (who, what, target, before/after, reason). Visible to SUPERADMIN.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String // e.g. "user.ban", "currency.grant", "store.item.update"
  targetType String? // user | guild | match | item | payment
  targetId   String?
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

// ─────────────── Admin Phase 2: config flags & campaigns ───────────────
model Config {
  key       String   @id
  value     String
  type      String   // "bool" | "int" | "string"
  category  String   // "flag"
  label     String
  updatedAt DateTime @updatedAt
}

model Campaign {
  id           String    @id @default(cuid())
  title        String
  body         String    @db.Text
  segment      String
  status       String    @default("sent")
  channel      String    @default("in-app")
  scheduledFor DateTime?
  reach        Int       @default(0)
  sentById     String?
  sentBy       User?     @relation(fields: [sentById], references: [id], onDelete: SetNull)
  sentByName   String
  createdAt    DateTime  @default(now())

  @@index([createdAt])
}

// ─────────────── Admin Phase 3: support tickets ───────────────
enum TicketStatus {
  OPEN
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id         String        @id @default(cuid())

  // The player who filed it. SetNull (not Cascade) so the ticket + thread survive a
  // hard account delete for the support record; a snapshot keeps it human-readable.
  userId     String?
  user       User?         @relation("ticketsFiled", fields: [userId], references: [id], onDelete: SetNull)
  userName   String        // snapshot: "username#tag" at file time
  userEmail  String?       // snapshot: the player's email at file time (staff-visible; from account)

  category   String        // "General" | "Account" | "Bug Report" | "Billing" (matches ContactPage CATEGORIES)
  subject    String        @db.Text
  status     TicketStatus  @default(OPEN)
  priority   TicketPriority @default(MEDIUM)

  resolvedById String?     // staff who resolved it (nullable FK, SetNull)
  resolvedBy   User?       @relation("ticketsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt   // bumped on every new message so the list can sort by "last activity"

  messages   TicketMessage[]

  @@index([status, updatedAt])   // serves the default queue: open tickets, most-recently-active first
  @@index([userId])
}

model TicketMessage {
  id         String    @id @default(cuid())

  ticketId   String
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  // Author SetNull so a message survives the author's account delete; isStaff records
  // which side wrote it (drives the thread bubble alignment + the "notify the player" rule).
  authorId   String?
  author     User?     @relation("ticketMessages", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String    // snapshot: "username#tag" (or staff display) at write time
  isStaff    Boolean   @default(false)
  body       String    @db.Text

  createdAt  DateTime  @default(now())

  @@index([ticketId, createdAt])
}

// ─────────────── Tournaments (V1: admin-managed single-elimination) ───────────────
enum TournamentFormat {
  SINGLE_ELIM       // knockout; one loss and you are out
  DOUBLE_ELIM       // winners + losers bracket; two losses to be out
  SWISS             // fixed rounds, paired on record, nobody eliminated
  ROUND_ROBIN       // everyone plays everyone; standings decide it
  GROUP_DOUBLE_ELIM // round-robin groups, cut the bottom of each, survivors into
                    // double elim with the top half seeded into the UPPER bracket
                    // and the bottom half straight into the LOWER one — the
                    // "Dota 2 The International" shape. The group stage IS winners
                    // round 1, which is why that round is never materialised.
                    // docs/superpowers/specs/2026-08-03-ti-group-stage-format-design.md
}

enum TournamentStatus {
  DRAFT       // being edited; not visible to players
  OPEN        // registration open; players may join/leave
  RUNNING     // bracket seeded; matches being played
  COMPLETED   // finished; prizes paid
  CANCELLED   // called off; entry fees refunded
}

model Tournament {
  id            String           @id @default(cuid())
  name          String
  format        TournamentFormat @default(SINGLE_ELIM)
  status        TournamentStatus @default(DRAFT)

  // Economy — GOLD ONLY (rule 2). No currency column: it is always gold.
  entryFeeGold  Int              @default(0)   // 0 = free entry
  prizePoolGold Int              @default(0)    // total gold paid out across placements

  // Bracket sizing — must be a power of two in {2..256}; validated on write.
  maxPlayers      Int              @default(16)
  registeredCount Int              @default(0)   // serialized counter — the capacity guard
                                                   // (see "Join" below). Incremented/decremented
                                                   // inside the same $transaction as entry
                                                   // create/delete; NEVER derived from a plain
                                                   // COUNT(*) on TournamentEntry at request time.
  minTrophies     Int              @default(0)    // trophy gate to join (0 = open to all)
  matchMode       MatchMode        @default(CASUAL) // the MatchMode tournament games run as (see below)

  /// READY CHECK (V1.5): seconds a player has to press Ready once their OPPONENT
  /// has readied, before losing the slot by no-show forfeit. Armed per slot by
  /// the FIRST Ready — see TournamentMatch.readyDeadlineAt. Editable while DRAFT
  /// like every other tournament setting.
  readyWindowSec  Int              @default(600)

  // SWISS ONLY: the configured number of Swiss rounds. Admin-settable at
  // create (optional); if left null, Start computes+persists
  // defaultSwissRounds(n) = ceil(log2(n)) the first time the tournament
  // starts. Unused (stays null) for every other format.
  rounds        Int?

  // GROUP_DOUBLE_ELIM ONLY. Admin-settable at create; required for that format
  // and null for every other. maxPlayers must divide evenly by groupCount, and
  // groupCount * qualifiersPerGroup (the survivor count) must be a power of two
  // — that product IS the playoff bracket size. Validated on write.
  groupCount         Int?
  qualifiersPerGroup Int?

  /// The seeded playoff bracket size, persisted at the moment the bracket is
  /// created.
  ///
  /// Every other format recovers B by COUNTING winners-round-1 slots, which
  /// works because they all seed that round. GROUP_DOUBLE_ELIM deliberately does
  /// not — its group stage replaces winners round 1 — so that count is 0 and the
  /// derivation yields B=0, which throws inside losersBracketStructure and makes
  /// every playoff match unreportable. Storing it removes the dependency on a
  /// row count for a value that is structural and immutable once seeded.
  bracketSize   Int?

  startsAt      DateTime?        // descriptive in V1 (admin-triggered start); scheduler is V2

  // Prize distribution — V1 pays ONLY the champion and runner-up (see "Prize payout
  // (V1: top-2 only, no ties)" below for why). JSON 2-tuple: [firstPrizeGold,
  // secondPrizeGold]. Validated at COMPLETE time: firstPrizeGold + secondPrizeGold
  // === prizePoolGold (else 400 PRIZE_SPLIT_MISMATCH). Placements 3+ are recorded on
  // TournamentEntry.placement for display but are NEVER paid in V1.
  prizeSplitGold Json           @default("[]")

  // ACCOUNT PURGE: SetNull. A Tournament is a PLATFORM object with entrants,
  // matches and a prize pool — it must outlive the admin who created it, and
  // Restrict would have made an admin's account undeletable. Nullable so the
  // authorship link can be dropped without destroying the event.
  createdById   String?
  createdBy     User?            @relation("tournamentsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  openedAt      DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?

  entries       TournamentEntry[]
  matches       TournamentMatch[]

  @@index([status, startsAt])
}

model TournamentEntry {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("tournamentEntries", fields: [userId], references: [id], onDelete: Cascade)

  seed         Int?       // 1..B, assigned at Start (null while OPEN)
  eliminated   Boolean    @default(false)
  placement    Int?       // final rank set at COMPLETE (1 = champion, 2 = runner-up, recorded
                           // for display beyond that). null = not yet placed / eliminated early.
                           // ONLY placement 1 and 2 are paid in V1 (see prize payout below).
  refunded     Boolean    @default(false) // entry fee refunded (cancel path). guards double-refund at app level too.
  joinedAt     DateTime   @default(now())

  // GROUP_DOUBLE_ELIM ONLY (null for every other format).
  // groupIndex is 0-based and assigned at Start by a snake draft over seeds.
  // groupPlacement is 1-based WITHIN the group and written once, when the group
  // stage completes and the qualification cut is applied — it is what decides
  // upper bracket vs lower bracket vs eliminated.
  groupIndex     Int?
  groupPlacement Int?

  // Opposite relation fields for TournamentMatch.redEntry/blueEntry (Prisma requires both
  // sides of a named relation). Not otherwise queried directly — matches are looked up via
  // TournamentMatch, not through these back-relations.
  redSlots     TournamentMatch[] @relation("tmRed")
  blueSlots    TournamentMatch[] @relation("tmBlue")

  @@unique([tournamentId, userId])   // one entry per player per tournament (dedupe)
  @@index([tournamentId, seed])
}

model TournamentMatch {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  round        Int        // 1 = first round; final round = log2(B)
  slot         Int        // 0-based position within the round (parent = slot >> 1 in round+1)

  // Which sub-bracket this slot belongs to. "W" (winners, the default —
  // SINGLE_ELIM/ROUND_ROBIN/SWISS never set anything else), "L" (losers), "GF"
  // (grand final), or "G" (GROUP_DOUBLE_ELIM's group stage). round/slot are
  // scoped WITHIN a bracket but the @@unique below is still
  // (tournamentId,round,slot) only — see the ROUND-OFFSET note in
  // tournaments-core.ts's DOUBLE_ELIM section for how these avoid colliding on
  // that unique index without a schema change (L rounds start at 101, GF at
  // 201, G at 301).
  bracket      String     @default("W")

  // The two competitors for this slot. null = not yet determined (awaiting a
  // feeder result) OR a bye (one side null with the other present in round 1).
  redEntryId   String?
  redEntry     TournamentEntry? @relation("tmRed",  fields: [redEntryId],  references: [id], onDelete: SetNull)
  blueEntryId  String?
  blueEntry    TournamentEntry? @relation("tmBlue", fields: [blueEntryId], references: [id], onDelete: SetNull)

  // The real Match this slot is/was played as, if any. As of V1.5 the SERVER
  // creates it: when both competitors have pressed Ready, the ready-check
  // auto-starts the match and CLAIMS it here via a conditional update
  // (`where: { id, matchId: null }`) — that claim is the race guard that makes
  // exactly one live match per slot (realtime/tournament-live.ts). An admin
  // reporting a result manually may still pass a matchId as a reference link.
  // null for byes, for a slot nobody has readied yet, or after a DRAW resets the
  // slot for a replay (the drawn Match row stays in history; this must be
  // cleared because the column is @unique and a replay needs a fresh match).
  matchId      String?    @unique
  match        Match?     @relation(fields: [matchId], references: [id], onDelete: SetNull)

  /// READY CHECK (V1.5). Set when that side's player presses Ready. When BOTH
  /// are non-null the server auto-starts the match. Cleared together with
  /// matchId when a draw resets the slot for a replay. There is deliberately no
  /// "un-ready": disarming the deadline would let a player stall the bracket
  /// forever, and leaving it armed with nobody ready has no fair resolution.
  redReadyAt      DateTime?
  blueReadyAt     DateTime?

  /// Armed by the FIRST Ready on this slot (now + Tournament.readyWindowSec) and
  /// cleared only when the match actually starts (or a draw resets the slot). At
  /// expiry the side that DID ready wins by no-show forfeit — fired promptly by
  /// the `tournament-noshow` job and, because that queue is at-most-once,
  /// guaranteed by sweepTournamentReadyChecks. Indexed for that sweep's scan.
  readyDeadlineAt DateTime?

  winnerEntryId String?   // set when the slot resolves (from admin report/bye/auto-advance)
  status        String     @default("pending") // "pending" | "ready" | "done"
  resolvedAt    DateTime?

  @@unique([tournamentId, round, slot])
  @@index([tournamentId, round])
  @@index([readyDeadlineAt])
}

// ─────────────── Live ops: Scheduled Events ───────────────
// Admin-authored calendar of live events (double-gold windows, tournaments,
// fiestas, sales, etc.) shown on the Live-ops "Scheduled Events" panel.
// startsLabel/endsLabel are free-text descriptive labels (mockup shows dates
// like "Jul 12", not real datetimes) — V1 has no scheduler that flips
// status automatically; admins set status via PATCH / the cancel route.
model LiveEvent {
  id            String   @id @default(cuid())
  name          String
  type          String                    // free-form select value: "double_gold" | "tournament" | "fiesta" | "sale" | "other"
  status        String   @default("scheduled")  // "scheduled" | "live" | "ended"
  scope         String                    // audience/segment label, free-form select value
  reward        String                    // free-text reward description (gold-only phrasing)
  startsLabel   String?                   // free-text "Jul 12" (mockup uses descriptive labels, not datetimes)
  endsLabel     String?
  color         String?                   // dot color hex for the row
  createdById   String?
  createdBy     User?    @relation("liveEventsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}
