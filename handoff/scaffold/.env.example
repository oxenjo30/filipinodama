# ── server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://dama:dama@localhost:5432/dama
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:5173

# ── oauth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
OAUTH_CALLBACK_BASE=http://localhost:4000

# ── payments (Stripe test keys in dev, live in prod) ────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── storage (S3 / Cloudflare R2) ────────────────────────
S3_ENDPOINT=
S3_BUCKET=dama-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── email (verification / password reset) ───────────────
SMTP_URL=
EMAIL_FROM="FilipinoDama Royal <no-reply@filipinodama.gg>"

# ── web (VITE_ prefixed = exposed to browser) ───────────
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
VITE_STRIPE_PUBLISHABLE_KEY=
